DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/yourdb
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
APP_NAME=AlgoStrat

# Resend (https://resend.com). Until you verify your own domain, Resend only
# delivers from onboarding@resend.dev to the email you signed up to Resend with.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Local development only: print codes in the terminal instead of emailing
DEV_PRINT_OTP=true
